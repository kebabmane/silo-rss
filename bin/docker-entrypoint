#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# If running the rails server then create or migrate existing database
if [[ "$*" == *"rails"*"server"* ]]; then
  echo "Running database migrations..."
  ./bin/rails db:prepare
fi

# For workers, wait for web container to run migrations first
if [[ "$*" == *"solid_queue:start"* ]]; then
  echo "Waiting for database to be ready..."
  sleep 10
  # Only run db:prepare if tables don't exist (avoid race condition)
  ./bin/rails db:prepare 2>/dev/null || echo "Database already prepared"
fi

exec "${@}"
