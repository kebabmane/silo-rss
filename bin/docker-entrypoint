#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# If running the rails server then create or migrate existing database
if [[ "$*" == *"rails"*"server"* ]]; then
  echo "Running database migrations..."
  ./bin/rails db:prepare
fi

# For workers, wait for web container to run migrations first
if [[ "$*" == *"solid_queue:start"* ]]; then
  echo "Waiting for database to be ready..."
  # Wait up to 60 seconds for database to be ready
  for i in {1..30}; do
    if ./bin/rails runner 'SolidQueue::RecurringTask.count' 2>/dev/null; then
      echo "Database ready, starting worker..."
      break
    fi
    echo "Waiting for database... ($i/30)"
    sleep 2
  done
fi

exec "${@}"
