<% @articles.each do |article| %>
  <% cache(article) do %>
    <% state = article.state_for(Current.user) %>
    <%= turbo_stream.append "articles-list", render("shared/article_card", article: article, read: state.read?, starred: state.starred?, selected: false) %>
  <% end %>
<% end %>

<% if @pagy.next %>
  <%= turbo_stream.replace "load-more-trigger", partial: "dashboard/load_more_trigger", locals: { next_page: @pagy.next } %>
<% else %>
  <%= turbo_stream.remove "load-more-trigger" %>
<% end %>
