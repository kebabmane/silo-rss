<div class="fixed inset-0 bg-black bg-opacity-50 z-40 flex items-center justify-center p-4" data-controller="onboarding">
  <div class="bg-white dark:bg-gray-950 rounded-lg shadow-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
    <!-- Header -->
    <div class="sticky top-0 border-b border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 px-6 py-4 flex justify-between items-center">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
        Welcome to Silo! 🎉
      </h2>
      <button type="button"
              data-action="click->onboarding#close"
              class="text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 text-2xl leading-none">
        ×
      </button>
    </div>

    <!-- Content -->
    <div class="px-6 py-8">
      <p class="text-gray-600 dark:text-gray-400 mb-8">
        Get started by adding some feeds. Choose from popular suggestions below, or add your own feeds manually.
      </p>

      <!-- Suggested Feeds by Category -->
      <% if @suggested_feeds_by_category.any? %>
        <div class="space-y-6">
          <% @suggested_feeds_by_category.each do |category, feeds| %>
            <div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">
                <%= category %>
              </h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <% feeds.each do |feed| %>
                  <div class="p-4 border border-gray-200 dark:border-gray-700 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition">
                    <div class="flex items-start justify-between">
                      <div class="flex-1">
                        <h4 class="font-medium text-gray-900 dark:text-white">
                          <%= feed.title %>
                        </h4>
                        <% if feed.description.present? %>
                          <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
                            <%= feed.description %>
                          </p>
                        <% end %>
                      </div>
                      <button type="button"
                              data-action="click->onboarding#addFeed"
                              data-feed-id="<%= feed.id %>"
                              data-feed-url="<%= feed.feed_url %>"
                              data-feed-category="<%= feed.category %>"
                              class="ml-2 px-3 py-1 bg-blue-600 hover:bg-blue-700 text-white text-sm rounded-md whitespace-nowrap">
                        Add
                      </button>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="p-6 bg-gray-50 dark:bg-gray-700/50 rounded-lg text-center">
          <p class="text-gray-600 dark:text-gray-400">
            No suggested feeds available yet. Your admin can add some via the admin panel.
          </p>
        </div>
      <% end %>

      <!-- Manual Entry / Other Options -->
      <div class="mt-8 pt-8 border-t border-gray-200 dark:border-gray-700">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">
          Or...
        </h3>
        <div class="space-y-3">
          <%= link_to "Add a Custom Feed", new_feed_path,
              class: "block p-4 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 text-center transition" %>
          <%= link_to "Import from OPML", "javascript:void(0)",
              data: { action: "click->onboarding#showOPML" },
              class: "block p-4 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 text-center transition" %>
          <button type="button"
                  data-action="click->onboarding#skip"
                  class="block w-full p-4 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 transition">
            Skip for Now
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Hidden form for adding feeds -->
<div id="hidden_feed_form" style="display: none;">
  <%= form_with url: feeds_path, method: :post, local: true, id: "feed_form" do |f| %>
    <%= f.hidden_field :feed_id %>
    <%= f.hidden_field :category %>
    <%= f.hidden_field :custom_name %>
  <% end %>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const modal = document.querySelector('[data-controller="onboarding"]');
    if (!modal) return;

    window.onboardingHandlers = {
      close: function() {
        // Mark onboarding as completed
        fetch('<%= mark_onboarding_completed_path %>', {
          method: 'POST',
          headers: {
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
          }
        }).then(() => modal.remove());
      },

      skip: function() {
        this.close();
      },

      addFeed: function(feedId, feedUrl, category) {
        // Discover and add the feed
        const form = document.getElementById('feed_form');
        form.querySelector('[name="feed_id"]').value = '';
        form.querySelector('[name="category"]').value = category;
        form.querySelector('[name="custom_name"]').value = '';

        // Use discover endpoint to get feed and then create subscription
        const discoverForm = document.createElement('form');
        discoverForm.method = 'POST';
        discoverForm.action = '<%= discover_feeds_path %>';
        discoverForm.innerHTML = `
          <input type="hidden" name="url" value="${feedUrl}">
          <input type="hidden" name="authenticity_token" value="${document.querySelector('meta[name="csrf-token"]').content}">
        `;
        document.body.appendChild(discoverForm);

        // After discovery, we need to handle creating the subscription
        fetch(discoverForm.action, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
          },
          body: `url=${encodeURIComponent(feedUrl)}`
        })
        .then(response => response.text())
        .then(html => {
          // Parse the response to get feed_id if available
          const parser = new DOMParser();
          const doc = parser.parseFromString(html, 'text/html');
          const feedId = doc.querySelector('[data-feed-id]')?.dataset.feedId;

          if (feedId) {
            // Submit the subscription form
            const subForm = document.createElement('form');
            subForm.method = 'POST';
            subForm.action = '<%= feeds_path %>';
            subForm.innerHTML = `
              <input type="hidden" name="feed_id" value="${feedId}">
              <input type="hidden" name="category" value="${category}">
              <input type="hidden" name="authenticity_token" value="${document.querySelector('meta[name="csrf-token"]').content}">
            `;
            document.body.appendChild(subForm);
            subForm.submit();
          }
        })
        .catch(error => console.error('Error adding feed:', error));

        discoverForm.remove();
      },

      showOPML: function() {
        // Create OPML upload modal
        const opmlForm = document.createElement('form');
        opmlForm.method = 'POST';
        opmlForm.action = '<%= import_opml_feeds_path %>';
        opmlForm.enctype = 'multipart/form-data';
        opmlForm.innerHTML = `
          <input type="file" name="opml_file" accept=".opml,.xml" style="display:none">
          <input type="hidden" name="authenticity_token" value="${document.querySelector('meta[name="csrf-token"]').content}">
        `;
        document.body.appendChild(opmlForm);
        opmlForm.querySelector('input[type="file"]').click();
        opmlForm.querySelector('input[type="file"]').addEventListener('change', () => {
          opmlForm.submit();
        });
      }
    };
  });
</script>
