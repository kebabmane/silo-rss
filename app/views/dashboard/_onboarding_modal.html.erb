<% subscribed_feed_urls = @subscriptions.map { |s| s.feed.feed_url } %>

<div class="fixed inset-0 bg-black/50 z-40 flex items-center justify-center p-4"
     data-controller="onboarding"
     data-onboarding-feeds-path-value="<%= feeds_path %>"
     data-onboarding-mark-completed-path-value="<%= mark_onboarding_completed_path %>"
     data-onboarding-subscribed-feed-urls-value="<%= subscribed_feed_urls.to_json %>"
     data-opml-path="<%= import_opml_feeds_path %>">
  <div class="bg-white dark:bg-gray-900 rounded-lg shadow-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
    <!-- Header -->
    <div class="sticky top-0 border-b border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 px-6 py-4 flex justify-between items-center z-10">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
        Welcome to Silo!
      </h2>
      <button type="button"
              data-action="click->onboarding#close"
              class="text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 text-2xl leading-none p-1"
              aria-label="Close">
        &times;
      </button>
    </div>

    <!-- Content -->
    <div class="px-6 py-8">
      <p class="text-gray-600 dark:text-gray-400 mb-8">
        Get started by adding some feeds. Choose from popular suggestions below, or add your own feeds manually.
      </p>

      <!-- Suggested Feeds by Category -->
      <% if @suggested_feeds_by_category.any? %>
        <div class="space-y-6">
          <% @suggested_feeds_by_category.each do |category, feeds| %>
            <div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">
                <%= category %>
              </h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <% feeds.each do |feed| %>
                  <% already_subscribed = subscribed_feed_urls.include?(feed.feed_url) %>
                  <div class="p-4 border border-gray-200 dark:border-gray-700 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800 transition">
                    <div class="flex items-start justify-between gap-3">
                      <div class="flex-1 min-w-0">
                        <h4 class="font-medium text-gray-900 dark:text-white truncate">
                          <%= feed.title %>
                        </h4>
                        <% if feed.description.present? %>
                          <p class="text-sm text-gray-600 dark:text-gray-400 mt-1 line-clamp-2">
                            <%= feed.description %>
                          </p>
                        <% end %>
                      </div>
                      <% if already_subscribed %>
                        <span class="flex-shrink-0 px-3 py-1 bg-green-600 text-white text-sm rounded-md cursor-default">
                          Added
                        </span>
                      <% else %>
                        <button type="button"
                                data-action="click->onboarding#addFeed"
                                data-feed-id="<%= feed.id %>"
                                data-feed-url="<%= feed.feed_url %>"
                                data-feed-category="<%= feed.category %>"
                                class="flex-shrink-0 px-3 py-1 bg-blue-600 hover:bg-blue-700 dark:hover:bg-blue-500 text-white text-sm rounded-md whitespace-nowrap transition focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-950">
                          Add
                        </button>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="p-6 bg-gray-50 dark:bg-gray-800 rounded-lg text-center">
          <p class="text-gray-600 dark:text-gray-400">
            No suggested feeds available yet. Your admin can add some via the admin panel.
          </p>
        </div>
      <% end %>

      <!-- Manual Entry / Other Options -->
      <div class="mt-8 pt-8 border-t border-gray-200 dark:border-gray-700">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">
          Or add your own...
        </h3>
        <div class="space-y-3">
          <%= link_to new_feed_path,
              class: "block p-4 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 text-center transition" do %>
            Add a Custom Feed
          <% end %>
          <button type="button"
                  data-action="click->onboarding#showOPML"
                  class="block w-full p-4 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 text-center transition">
            Import from OPML
          </button>
        </div>
      </div>

      <!-- Footer Actions -->
      <div class="mt-8 pt-6 border-t border-gray-200 dark:border-gray-700 flex justify-end">
        <button type="button"
                data-action="click->onboarding#skip"
                class="px-4 py-2 text-sm text-gray-600 dark:text-gray-400 hover:text-gray-800 dark:hover:text-gray-200 transition">
          Skip for now
        </button>
      </div>
    </div>
  </div>
</div>
