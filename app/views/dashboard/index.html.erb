<!-- Onboarding Modal -->
<% if @subscriptions.empty? && !Current.user.onboarding_completed? %>
  <%= render "dashboard/onboarding_modal" %>
<% end %>

<div data-controller="focus-mode" data-focus-mode-target="layout" class="dashboard-layout flex h-[calc(100vh-4rem)]" data-current-filter="<%= params[:filter] || 'unread' %>">
  <!-- Left Sidebar: Categories and Feeds -->
  <div class="dashboard-sidebar w-64 flex-shrink-0 bg-white dark:bg-gray-950 border-r border-gray-200 dark:border-gray-700 overflow-y-auto" data-controller="filter-highlight">
    <div class="p-4">
      <!-- Filter Buttons -->
      <div class="mb-5 space-y-2">
        <%= link_to dashboard_path(filter: "unread"), class: "block px-3 py-2.5 text-sm rounded-md transition font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-gray-950", data: { turbo_frame: "articles_list", filter_link: true, filter_value: "unread" } do %>
          <span>Unread</span>
        <% end %>
        <%= link_to dashboard_path(filter: "starred"), class: "block px-3 py-2.5 text-sm rounded-md transition font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-gray-950", data: { turbo_frame: "articles_list", filter_link: true, filter_value: "starred" } do %>
          <span><span aria-hidden="true">⭐</span> Starred</span>
        <% end %>
        <%= link_to dashboard_path(filter: "all"), class: "block px-3 py-2.5 text-sm rounded-md transition font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-gray-950", data: { turbo_frame: "articles_list", filter_link: true, filter_value: "all" } do %>
          <span>All Articles</span>
        <% end %>
      </div>

      <hr class="my-4 border-gray-200 dark:border-gray-700">

      <!-- Categories and Feeds -->
      <% @categories.group_by(&:itself).each do |category, _| %>
        <div class="mb-5">
          <h3 class="px-3 text-xs font-semibold text-gray-600 dark:text-gray-500 tracking-widest mb-3">
            <%= category.upcase %>
          </h3>
          <% (@subscriptions_by_category[category] || []).each do |subscription| %>
            <%= link_to dashboard_path(feed_id: subscription.feed_id, filter: "all"),
                class: "block px-3 py-2.5 text-sm rounded-md transition font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700",
                data: { turbo_frame: "articles_list", feed_link: true, feed_id: subscription.feed_id } do %>
              <%= subscription.display_name %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Middle: Articles List -->
  <%= turbo_frame_tag "articles_list", class: "dashboard-article-list w-96 bg-white dark:bg-gray-950 border-r border-gray-200 dark:border-gray-700 overflow-y-auto flex flex-col", data: { current_filter: params[:filter] || "unread", current_feed_id: params[:feed_id], current_category: params[:category] } do %>
    <!-- Mobile search bar -->
    <div class="p-4 border-b border-gray-200 dark:border-gray-700 flex-shrink-0 md:hidden">
      <%= form_with url: search_path, method: :get, data: { turbo_frame: "articles_list" }, class: "relative" do |f| %>
        <%= f.text_field :q,
            placeholder: "Search articles...",
            value: params[:q],
            class: "w-full px-4 py-2 pr-20 text-sm border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
        <div class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center gap-1">
          <% if params[:q].present? %>
            <%= link_to dashboard_path,
                data: { turbo_frame: "articles_list" },
                class: "px-2 py-1 text-xs text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200" do %>
              Clear
            <% end %>
          <% end %>
          <%= f.submit "Search", class: "px-4 py-2 text-sm bg-blue-600 hover:bg-blue-700 dark:hover:bg-blue-500 text-white rounded-md cursor-pointer min-h-[44px] min-w-[44px] focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-950" %>
        </div>
      <% end %>
    </div>

    <div id="articles-list" class="divide-y divide-gray-200 dark:divide-gray-700 flex-1 overflow-y-auto">
      <% @articles.each do |article| %>
        <% cache(article) do %>
          <% state = article.state_for(Current.user) %>
          <% selected = params[:article_id].to_i == article.id %>
          <% read = state.read? %>
          <% card_classes = [
              "group relative block px-4 py-4 border-l-4 transition",
              "hover:bg-gray-50 dark:hover:bg-gray-800",
              selected ? "bg-blue-50 dark:bg-blue-900/40" : "bg-transparent",
              selected ? "border-blue-500 dark:border-blue-400" : "border-transparent"
            ].join(" ") %>
          <%= link_to dashboard_path(article_id: article.id),
              class: card_classes,
              data: {
                turbo_frame: "article_content",
                action: "click->keyboard#selectArticle",
                article_id: article.id
              } do %>
            <div class="flex items-start gap-3">
              <span class="mt-1.5 h-3 w-3 rounded-full flex-shrink-0 <%= read ? 'bg-gray-300 dark:bg-gray-600' : 'bg-blue-500 dark:bg-blue-400' %>"></span>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium <%= read ? 'text-gray-700 dark:text-gray-200' : 'text-gray-900 dark:text-gray-100' %> transition group-hover:text-blue-600 dark:group-hover:text-blue-300 line-clamp-2">
                  <%= article.title %>
                </p>
                <div class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-gray-500 dark:text-gray-400">
                  <span class="truncate max-w-xs"><%= article.feed.title %></span>
                  <% if article.published_at.present? %>
                    <span aria-hidden="true">•</span>
                    <time datetime="<%= article.published_at.iso8601 %>"><%= format_user_time(article.published_at, style: :short_date) %></time>
                  <% end %>
                </div>
              </div>
              <% if state.starred? %>
                <span class="flex items-center text-yellow-600 dark:text-yellow-400" aria-label="Starred">
                  <span aria-hidden="true">⭐</span>
                </span>
              <% end %>
            </div>
          <% end %>
        <% end %>
      <% end %>

      <% if @articles.empty? %>
        <div class="p-8 text-center text-gray-500 dark:text-gray-400">
          <p>No articles found</p>
          <p class="text-sm mt-2">Add some feeds to get started!</p>
        </div>
      <% elsif @pagy.next %>
        <%= render "dashboard/load_more_trigger", next_page: @pagy.next %>
      <% end %>
    </div>
  <% end %>

  <!-- Right: Article Content -->
  <%= turbo_frame_tag "article_content", class: "dashboard-article-pane flex-1 overflow-y-auto bg-white dark:bg-black" do %>
    <% if @selected_article %>
      <% state = @selected_article.state_for(Current.user) %>
      <article class="max-w-3xl lg:max-w-4xl mx-auto px-6 py-10 md:px-12 md:py-16 space-y-8">
        <header class="space-y-4 mb-8">
          <div class="space-y-3">
            <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white leading-tight">
              <%= @selected_article.title %>
            </h1>
          </div>
          <div class="flex flex-wrap items-center justify-between gap-4 text-base text-gray-600 dark:text-gray-400">
            <div class="flex flex-wrap items-center gap-3">
              <span class="font-semibold text-gray-700 dark:text-gray-300"><%= @selected_article.feed.title %></span>
              <% if @selected_article.published_at.present? %>
                <span aria-hidden="true">•</span>
                <time datetime="<%= @selected_article.published_at.iso8601 %>" class="text-gray-500 dark:text-gray-500"><%= format_user_time(@selected_article.published_at, style: :long_date) %></time>
              <% end %>
            </div>
            <% if @selected_article.url.present? %>
              <div class="flex items-center gap-2">
                <a href="<%= @selected_article.url %>" target="_blank" class="inline-flex items-center gap-2 px-3 py-1.5 text-sm rounded-full text-blue-600 dark:text-blue-300 border border-transparent hover:bg-blue-50 dark:hover:bg-blue-900/30 transition whitespace-nowrap">
                  View Original →
                </a>
              </div>
            <% end %>
          </div>
        </header>

        <% base_toolbar_classes = "inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg border transition focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" %>

        <div class="flex flex-wrap items-center gap-3">
          <%= button_to toggle_read_article_path(@selected_article),
              method: :patch,
              class: "#{base_toolbar_classes} #{state.read? ? 'bg-gray-100 dark:bg-gray-800 border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-200 hover:bg-gray-200 dark:hover:bg-gray-700' : 'bg-blue-50 dark:bg-blue-900/50 border-blue-300 dark:border-blue-700 text-blue-700 dark:text-blue-200 hover:bg-blue-100 dark:hover:bg-blue-800/60'}",
              data: { turbo: false } do %>
            <%= state.read? ? "Mark Unread" : "Mark Read" %>
          <% end %>

          <%= button_to toggle_starred_article_path(@selected_article),
              method: :patch,
              class: "#{base_toolbar_classes} #{state.starred? ? 'bg-amber-50 dark:bg-amber-900/50 border-amber-300 dark:border-amber-700 text-amber-700 dark:text-amber-200 hover:bg-amber-100 dark:hover:bg-amber-800/60' : 'bg-gray-100 dark:bg-gray-800 border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-200 hover:bg-gray-200 dark:hover:bg-gray-700'}",
              data: { turbo: false } do %>
            <%= state.starred? ? "⭐ Starred" : "☆ Star" %>
          <% end %>

          <%= button_to toggle_archived_article_path(@selected_article),
              method: :patch,
              class: "#{base_toolbar_classes} bg-gray-100 dark:bg-gray-800 border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-200 hover:bg-gray-200 dark:hover:bg-gray-700" do %>
            Archive
          <% end %>

          <%= button_to fetch_content_article_path(@selected_article),
              method: :post,
              class: "#{base_toolbar_classes} #{@selected_article.full_content_fetched? ? 'bg-green-50 dark:bg-green-900/30 border-green-300 dark:border-green-700 text-green-700 dark:text-green-200 hover:bg-green-100 dark:hover:bg-green-800/50' : 'bg-purple-50 dark:bg-purple-900/30 border-purple-300 dark:border-purple-700 text-purple-700 dark:text-purple-200 hover:bg-purple-100 dark:hover:bg-purple-800/50'}" do %>
            <%= @selected_article.full_content_fetched? ? "🔄 Re-fetch Content" : "📥 Fetch Full Content" %>
          <% end %>
        </div>

        <div class="prose prose-base md:prose-lg dark:prose-invert max-w-none article-content leading-relaxed">
          <%= sanitize @selected_article.display_content, tags: %w[div p br strong em a h1 h2 h3 h4 h5 h6 ul ol li blockquote img pre code span table thead tbody tr th td], attributes: %w[href src alt class] %>
        </div>
      </article>

      <!-- Auto-mark as read -->
      <% unless state.read? %>
        <%= turbo_stream_from "article_#{@selected_article.id}" %>
        <div data-controller="auto-read"
             data-auto-read-url-value="<%= toggle_read_article_path(@selected_article) %>">
        </div>
      <% end %>
    <% else %>
      <div class="flex items-center justify-center h-full text-gray-500 dark:text-gray-400">
        <p>Select an article to read</p>
      </div>
    <% end %>
  <% end %>
</div>
