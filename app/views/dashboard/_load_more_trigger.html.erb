<div id="load-more-trigger" data-controller="infinite-scroll" data-infinite-scroll-url-value="<%= dashboard_more_articles_path %>" data-infinite-scroll-page-value="<%= next_page %>" data-infinite-scroll-filter-value="<%= params[:filter] || 'unread' %>" class="py-8 text-center">
  <div class="inline-flex items-center gap-2 text-gray-500 dark:text-gray-400">
    <div class="animate-spin h-4 w-4 border-2 border-gray-300 dark:border-gray-700 border-t-gray-600 dark:border-t-gray-300 rounded-full"></div>
    <span class="text-sm">Loading more articles...</span>
  </div>
</div>
