<!DOCTYPE html>
<html>
<head>
  <meta content="text/html; charset=UTF-8" http-equiv="Content-Type">
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      line-height: 1.6;
      color: #333;
      max-width: 800px;
      margin: 0 auto;
      padding: 20px;
    }
    .header {
      border-bottom: 3px solid #3b82f6;
      padding-bottom: 20px;
      margin-bottom: 30px;
    }
    .header h1 {
      margin: 0;
      color: #1f2937;
    }
    .meta {
      color: #6b7280;
      font-size: 14px;
      margin-top: 5px;
    }
    .content {
      white-space: pre-wrap;
      line-height: 1.8;
    }
    .footer {
      margin-top: 40px;
      padding-top: 20px;
      border-top: 1px solid #e5e7eb;
      color: #6b7280;
      font-size: 14px;
    }
  </style>
</head>
<body>
  <div class="header">
    <h1>Your Daily Brief</h1>
    <div class="meta">
      Generated on <%= format_user_time(@brief.generated_at, style: :long) %>
      <br>
      <%= @brief.article_count %> <%= "article".pluralize(@brief.article_count) %> summarized
    </div>
  </div>

  <div class="content">
    <%= simple_format(@brief.content) %>
  </div>

  <div class="footer">
    <p>
      This daily brief was automatically generated based on your schedule preferences.
      <br>
      To manage your daily brief settings, visit your Silo dashboard.
    </p>
  </div>
</body>
</html>
