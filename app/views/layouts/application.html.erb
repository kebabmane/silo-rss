<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "Silo" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <script nonce="<%= content_security_policy_nonce %>">
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/service-worker', { scope: '/' })
          .then(reg => console.log('Service Worker registered'))
          .catch(err => console.log('Service Worker registration failed:', err));
      }
    </script>
  </head>

  <body class="h-full bg-gray-100 dark:bg-gray-950" data-controller="keyboard theme">
    <% if Current.user %>
      <nav class="bg-white dark:bg-gray-950 border-b border-gray-200 dark:border-gray-700 fixed top-0 left-0 right-0 z-30" role="navigation" aria-label="Main navigation">
        <div class="max-w-full mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex justify-between items-center h-16 gap-4">
            <div class="flex items-center flex-shrink-0">
              <%= link_to dashboard_path, class: "text-xl font-bold text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 rounded", aria_label: "Silo home" do %>
                Silo
              <% end %>
            </div>
            <div class="hidden md:flex items-center justify-center flex-1">
              <%= form_with url: search_path, method: :get, data: { turbo_frame: "articles_list" }, class: "flex items-center gap-2" do |f| %>
                <%= f.text_field :q,
                    placeholder: "Search articles...",
                    value: params[:q],
                    class: "w-80 px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
                <div class="flex items-center gap-2">
                  <% if params[:q].present? %>
                    <%= link_to "Clear", dashboard_path, data: { turbo_frame: "articles_list" }, class: "text-xs text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200" %>
                  <% end %>
                  <%= f.submit "Search", class: "px-3 py-2 text-sm font-medium bg-blue-600 hover:bg-blue-700 text-white rounded-md cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900" %>
                </div>
              <% end %>
            </div>
            <div class="flex items-center gap-2 sm:gap-3">
              <%= link_to "Add Feed", new_feed_path, class: "px-3 py-2 text-sm font-medium text-white bg-blue-600 rounded-md shadow-sm hover:bg-blue-700 dark:hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900", aria_label: "Add new feed" %>

              <div class="relative dropdown-trigger" data-controller="dropdown">
                <details class="nav-menu">
                  <summary class="inline-flex items-center gap-2 px-3 py-2 text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-md cursor-pointer transition" title="Menu" aria-label="Menu">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.75a.75.75 0 110-1.5.75.75 0 010 1.5zM12 12.75a.75.75 0 110-1.5.75.75 0 010 1.5zM12 18.75a.75.75 0 110-1.5.75.75 0 010 1.5z" />
                    </svg>
                    <span>Menu</span>
                  </summary>
                  <div class="absolute right-0 mt-2 z-30 w-52 rounded-md border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-950 shadow-lg py-2">
                    <%= link_to "Sync Feeds", refresh_all_feeds_path, data: { turbo_method: :post }, class: "block px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700", aria_label: "Synchronize all feeds" %>
                    <hr class="my-1 border-gray-200 dark:border-gray-700" />
                    <%= link_to "Settings", settings_path, class: "block px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700" %>
                    <hr class="my-1 border-gray-200 dark:border-gray-700" />
                    <button type="button" data-action="click->focus-mode#toggle" class="w-full text-left px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700" title="Toggle focus mode">
                      Focus Mode
                    </button>
                    <button type="button" data-action="click->keyboard#showHelp" class="w-full text-left px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700" title="Show keyboard shortcuts">
                      Keyboard Shortcuts
                    </button>
                  </div>
                </details>
              </div>

              <% if Current.user&.admin? %>
                <div class="relative dropdown-trigger" data-controller="dropdown">
                  <details class="nav-menu">
                    <summary class="inline-flex items-center gap-2 px-3 py-2 text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-md cursor-pointer transition" title="Admin Menu" aria-label="Admin Menu">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                      </svg>
                      <span>Admin</span>
                    </summary>
                  <div class="absolute right-0 mt-2 z-40 w-52 rounded-md border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-950 shadow-lg py-2">
                      <%= link_to "Dashboard", admin_root_path, class: "block px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 whitespace-nowrap", role: "menuitem" %>
                      <%= link_to "Users", admin_users_path, class: "block px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 whitespace-nowrap", role: "menuitem" %>
                      <%= link_to "Suggested Feeds", admin_suggested_feeds_path, class: "block px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 whitespace-nowrap", role: "menuitem" %>
                      <hr class="my-1 border-gray-200 dark:border-gray-700" />
                      <%= link_to "Settings", admin_settings_path, class: "block px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 whitespace-nowrap", role: "menuitem" %>
                      <%= link_to "Jobs", mission_control_jobs_path, class: "block px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 whitespace-nowrap", role: "menuitem" %>
                    </div>
                  </details>
                </div>
              <% end %>

              <button data-action="click->theme#toggle" class="inline-flex items-center justify-center h-9 w-9 rounded-full border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" aria-label="Toggle dark mode">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"/>
                </svg>
              </button>

              <%= button_to "Sign Out", session_path, method: :delete, class: "px-3 py-2 text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-md transition", aria_label: "Sign out" %>
            </div>
          </div>
        </div>
      </nav>
      <main class="pt-16 h-full">
        <% if flash.any? %>
          <div class="fixed bottom-6 right-6 z-50 space-y-2">
            <% flash.each do |type, message| %>
              <div data-controller="flash" data-flash-timeout-value="10000" class="px-4 py-3 rounded-md shadow-lg transition transform duration-500 ease-out <%= type == 'notice' ? 'bg-green-100 border border-green-400 text-green-700 dark:bg-green-800 dark:border-green-600 dark:text-green-100' : 'bg-red-100 border border-red-400 text-red-700 dark:bg-red-800 dark:border-red-600 dark:text-red-100' %>">
                <%= message %>
              </div>
            <% end %>
          </div>
        <% end %>
        <%= yield %>
      </main>
    <% else %>
      <!-- Theme toggle for public pages -->
      <div class="fixed top-4 right-4 z-40" data-controller="theme">
        <button data-action="click->theme#toggle" class="p-2 rounded-lg bg-white dark:bg-gray-800 shadow-lg text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white border border-gray-200 dark:border-gray-700" aria-label="Toggle dark mode">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"/>
          </svg>
        </button>
      </div>
      <main class="min-h-screen flex items-center justify-center bg-gray-100 dark:bg-gray-950">
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
