<div class="min-h-screen bg-gray-50 dark:bg-gray-900 py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-2">Feed Management</h1>
      <p class="text-gray-600 dark:text-gray-400">
        Total Feeds: <span class="font-semibold"><%= Feed.count %></span> |
        Orphaned: <span class="font-semibold text-orange-600"><%= @orphaned_feeds_count %></span>
      </p>
    </div>

    <!-- Orphaned Feeds Warning -->
    <% if @orphaned_feeds_count > 0 %>
      <div class="mb-6 p-4 bg-orange-50 dark:bg-orange-900/20 border border-orange-200 dark:border-orange-700 rounded-lg">
        <h2 class="text-lg font-semibold text-orange-900 dark:text-orange-100 mb-2">⚠️ Orphaned Feeds</h2>
        <p class="text-sm text-orange-800 dark:text-orange-200 mb-3">
          <%= @orphaned_feeds_count %> feed(s) have no subscribers and can be deleted to clean up the database.
        </p>
      </div>
    <% end %>

    <!-- Feeds Table -->
    <div class="bg-white dark:bg-gray-950 rounded-lg shadow-lg border border-gray-200 dark:border-gray-700">
      <% if @feeds.any? %>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-gray-50 dark:bg-gray-900 border-b border-gray-200 dark:border-gray-600">
              <tr>
                <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900 dark:text-white">Title</th>
                <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900 dark:text-white">Feed URL</th>
                <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900 dark:text-white">Subscribers</th>
                <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900 dark:text-white">Articles</th>
                <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900 dark:text-white">Last Fetched</th>
                <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900 dark:text-white">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
              <% @feeds.each do |feed| %>
                <% is_orphaned = feed.subscriptions.empty? %>
                <tr class="<%= is_orphaned ? 'bg-orange-50 dark:bg-orange-900/10 hover:bg-orange-100 dark:hover:bg-orange-900/20' : 'hover:bg-gray-50 dark:hover:bg-gray-700' %>">
                  <td class="px-6 py-3 text-sm font-medium text-gray-900 dark:text-gray-100">
                    <div class="flex items-center gap-2">
                      <% if is_orphaned %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 dark:bg-orange-900 text-orange-800 dark:text-orange-200">
                          Orphaned
                        </span>
                      <% end %>
                      <%= feed.title %>
                    </div>
                  </td>
                  <td class="px-6 py-3 text-sm text-gray-600 dark:text-gray-400 truncate max-w-xs" title="<%= feed.feed_url %>">
                    <%= feed.feed_url %>
                  </td>
                  <td class="px-6 py-3 text-sm text-gray-900 dark:text-gray-100">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200">
                      <%= feed.subscriber_count %>
                    </span>
                  </td>
                  <td class="px-6 py-3 text-sm text-gray-900 dark:text-gray-100">
                    <%= feed.articles_count %>
                  </td>
                  <td class="px-6 py-3 text-sm text-gray-600 dark:text-gray-400">
                    <% if feed.last_fetched_at %>
                      <%= time_ago_in_words(feed.last_fetched_at) %> ago
                    <% else %>
                      Never
                    <% end %>
                  </td>
                  <td class="px-6 py-3 text-sm space-x-2">
                    <% if is_orphaned %>
                      <%= link_to "Delete", admin_feed_path(feed), method: :delete, data: { confirm: "Are you sure you want to delete this orphaned feed? This action cannot be undone." }, class: "text-red-600 dark:text-red-400 hover:underline font-medium" %>
                    <% else %>
                      <span class="text-gray-400 dark:text-gray-600 text-xs">—</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="p-8 text-center text-gray-500 dark:text-gray-400">
          <p class="text-lg">No feeds in the system</p>
        </div>
      <% end %>

    </div>

    <div class="mt-6">
      <%= link_to "← Back to Admin", admin_root_path, class: "text-blue-600 dark:text-blue-400 hover:underline" %>
    </div>
  </div>
</div>
