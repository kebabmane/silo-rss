<div class="min-h-screen bg-gray-50 dark:bg-gray-900 py-8">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-2xl font-semibold text-gray-900 dark:text-gray-100">
          Daily Brief Prompt Preview
        </h1>
        <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
          Review the exact prompt we send to the LLM before each daily brief is generated.
        </p>
      </div>
    </div>

    <% if @schedules.empty? %>
      <div class="rounded-md bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-700 p-4">
        <p class="text-sm text-yellow-800 dark:text-yellow-100">
          No daily brief schedules found. Create a schedule to preview prompts.
        </p>
      </div>
    <% else %>
      <div class="bg-white dark:bg-gray-950 border border-gray-200 dark:border-gray-700 rounded-lg shadow-lg">
      <div class="border-b border-gray-200 dark:border-gray-700 p-4">
        <%= form_with url: admin_daily_brief_prompts_path, method: :get, local: true, class: "flex flex-col gap-4 md:flex-row md:items-end md:justify-between" do |form| %>
          <div class="md:w-2/3">
            <%= form.label :schedule_id, "Select schedule", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
            <%= form.select :schedule_id,
                  options_from_collection_for_select(
                    @schedules,
                    :id,
                    ->(schedule) {
                      user = schedule.user
                      time = schedule.time_of_day&.strftime("%H:%M")
                      label = "#{user.email_address} • #{schedule.summary_length.titleize} summary"
                      label += " • #{time}" if time.present?
                      label
                    },
                    @selected_schedule&.id
                  ),
                  {},
                  class: "mt-1 block w-full rounded-md border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 shadow-sm focus:border-blue-500 focus:ring-blue-500"
                %>
          </div>
          <div class="md:w-auto">
            <%= form.submit "Load Prompt", class: "inline-flex items-center px-4 py-2 rounded-md bg-blue-600 text-white text-sm font-medium hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" %>
          </div>
        <% end %>
      </div>

      <% if @selected_schedule %>
        <% if @prompt_error.present? %>
          <div class="p-6">
            <div class="rounded-md bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-700 p-4">
              <h2 class="text-sm font-semibold text-red-800 dark:text-red-200 uppercase tracking-wide mb-2">LiteLLM not configured</h2>
              <p class="text-sm text-red-700 dark:text-red-100">
                <%= @prompt_error %>. Update the LiteLLM settings to enable prompt previews.
              </p>
              <div class="mt-3">
                <%= link_to "Configure LiteLLM", admin_litellm_settings_path, class: "inline-flex items-center px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-sm font-medium rounded-md" %>
              </div>
            </div>
          </div>
        <% else %>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 p-6">
          <section class="lg:col-span-1 space-y-4">
            <div class="rounded-md border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/60 p-4">
              <h2 class="text-sm font-semibold text-gray-800 dark:text-gray-200 uppercase tracking-wide">
                Schedule details
              </h2>
              <dl class="mt-3 space-y-2 text-sm text-gray-700 dark:text-gray-300">
                <div>
                  <dt class="font-medium text-gray-600 dark:text-gray-400">User</dt>
                  <dd><%= @selected_schedule.user.email_address %></dd>
                </div>
                <div>
                  <dt class="font-medium text-gray-600 dark:text-gray-400">Summary length</dt>
                  <dd><%= @selected_schedule.summary_length.titleize %></dd>
                </div>
                <div>
                  <dt class="font-medium text-gray-600 dark:text-gray-400">Time of day</dt>
                  <dd>
                    <% if @selected_schedule.time_of_day.present? %>
                      <%= @selected_schedule.time_of_day.strftime("%I:%M %p") %>
                    <% else %>
                      —
                    <% end %>
                  </dd>
                </div>
                <div>
                  <dt class="font-medium text-gray-600 dark:text-gray-400">Active days</dt>
                  <dd>
                    <% if @selected_schedule.days_of_week.present? %>
                      <%= @selected_schedule.days_of_week.map(&:titleize).join(", ") %>
                    <% else %>
                      Every day
                    <% end %>
                  </dd>
                </div>
                <div>
                  <dt class="font-medium text-gray-600 dark:text-gray-400">Feeds included</dt>
                  <dd>
                    <% if @selected_schedule.include_all_feeds? %>
                      All subscribed feeds
                    <% else %>
                      <ul class="list-disc pl-4 space-y-1">
                        <% @selected_schedule.filtered_feeds.each do |feed| %>
                          <li><%= feed.title %></li>
                        <% end %>
                      </ul>
                    <% end %>
                  </dd>
                </div>
              </dl>
            </div>

            <div class="rounded-md border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/60 p-4">
              <h2 class="text-sm font-semibold text-gray-800 dark:text-gray-200 uppercase tracking-wide">
                Articles in upcoming brief
              </h2>
              <% if @articles.empty? %>
                <p class="text-sm text-gray-600 dark:text-gray-400 mt-2">
                  No unread articles from the past 24 hours. The generator will create an "empty" brief.
                </p>
              <% else %>
                <ul class="mt-3 space-y-3">
                  <% @articles.each do |article| %>
                    <li class="border border-gray-200 dark:border-gray-700 rounded-md p-3 bg-white dark:bg-gray-900">
                      <p class="text-sm font-medium text-gray-900 dark:text-gray-100">
                        <%= article.title %>
                      </p>
                      <p class="text-xs text-gray-600 dark:text-gray-400 mt-1">
                        <%= article.feed.title %>
                        <% if article.published_at.present? %>
                          • <%= format_user_time(article.published_at, style: :month_day_time) %>
                        <% end %>
                      </p>
                    </li>
                  <% end %>
                </ul>
              <% end %>
            </div>
          </section>

          <section class="lg:col-span-2">
            <div class="flex items-center justify-between mb-3">
              <h2 class="text-sm font-semibold text-gray-800 dark:text-gray-200 uppercase tracking-wide">
                Prompt preview
              </h2>
              <p class="text-xs text-gray-500 dark:text-gray-400">
                Generated for <%= pluralize(@articles.count, "article") %> in the last 24 hours.
              </p>
            </div>
            <textarea id="prompt-preview"
                      readonly
                      rows="24"
                      class="w-full rounded-md border border-gray-300 dark:border-gray-600 bg-gray-900 text-green-200 font-mono text-xs leading-relaxed p-4 focus:outline-none">
<%= @prompt %></textarea>
          </section>
        </div>
        <% end %>
      <% else %>
        <div class="p-6">
          <div class="rounded-md bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-700 p-4">
            <p class="text-sm text-yellow-800 dark:text-yellow-100">
              Select a schedule to preview its prompt.
            </p>
          </div>
        </div>
      <% end %>
      </div>
    <% end %>
  </div>
</div>
