<div class="min-h-screen bg-gray-50  py-8">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-3xl font-bold text-gray-900 ">Suggested Feeds</h1>
      <%= link_to "Add Suggested Feed", new_admin_suggested_feed_path, class: "px-4 py-2 bg-blue-600 hover:bg-blue-700  text-white rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 " %>
    </div>

    <div class="bg-white  rounded-lg shadow-lg border border-gray-200 ">
      <% if @suggested_feeds.any? %>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-gray-50  border-b border-gray-200 ">
              <tr>
                <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900 ">Title</th>
                <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900 ">Category</th>
                <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900 ">Feed URL</th>
                <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900 ">Order</th>
                <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900 ">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 ">
              <% @suggested_feeds.each do |feed| %>
                <tr class="hover:bg-gray-50 ">
                  <td class="px-6 py-3 text-sm text-gray-900 ">
                    <%= feed.title %>
                  </td>
                  <td class="px-6 py-3 text-sm text-gray-600 ">
                    <span class="inline-block px-2 py-1 bg-blue-100  text-blue-800  rounded text-xs font-medium">
                      <%= feed.category %>
                    </span>
                  </td>
                  <td class="px-6 py-3 text-sm text-gray-600  truncate max-w-xs" title="<%= feed.feed_url %>">
                    <%= feed.feed_url %>
                  </td>
                  <td class="px-6 py-3 text-sm text-gray-900 ">
                    <%= feed.display_order || "—" %>
                  </td>
                  <td class="px-6 py-3 text-sm space-x-2">
                    <%= link_to "Edit", edit_admin_suggested_feed_path(feed), class: "text-blue-600  hover:underline" %>
                    <%= link_to "Delete", admin_suggested_feed_path(feed), method: :delete, data: { confirm: "Are you sure?" }, class: "text-red-600  hover:underline" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="p-8 text-center text-gray-500 ">
          <p class="text-lg">No suggested feeds yet</p>
          <p class="text-sm mt-2">Create some to help users get started with your server</p>
        </div>
      <% end %>
    </div>

    <div class="mt-6">
      <%= link_to "← Back to Admin", admin_users_path, class: "text-blue-600  hover:underline" %>
    </div>
  </div>
</div>
