<%= form_with model: [:admin, @suggested_feed], local: true do |f| %>
  <% if @suggested_feed.errors.any? %>
    <div class="mb-4 p-4 bg-red-50  border border-red-200  rounded-md">
      <h2 class="text-sm font-semibold text-red-800  mb-2">
        <%= pluralize(@suggested_feed.errors.count, "error") %> prohibited this feed from being saved:
      </h2>
      <ul class="text-sm text-red-700  list-disc list-inside">
        <% @suggested_feed.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-4">
    <div>
      <%= f.label :title, "Feed Title", class: "block text-sm font-medium text-gray-700  mb-1" %>
      <%= f.text_field :title,
          placeholder: "e.g., BBC News",
          class: "w-full px-3 py-2 border border-gray-300  bg-white  text-gray-900  rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500  transition" %>
    </div>

    <div>
      <%= f.label :feed_url, "Feed URL", class: "block text-sm font-medium text-gray-700  mb-1" %>
      <%= f.text_field :feed_url,
          placeholder: "https://example.com/feed.xml",
          class: "w-full px-3 py-2 border border-gray-300  bg-white  text-gray-900  rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500  transition" %>
    </div>

    <div>
      <%= f.label :category, "Category", class: "block text-sm font-medium text-gray-700  mb-1" %>
      <% if @categories.any? %>
        <%= f.select :category,
            options_for_select(@categories, @suggested_feed.category),
            { prompt: "Select a category or create new..." },
            class: "w-full px-3 py-2 border border-gray-300  bg-white  text-gray-900  rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500  transition" %>
        <p class="text-xs text-gray-500  mt-1">Or type a new category name</p>
      <% end %>
      <%= f.text_field :category,
          placeholder: "e.g., News, Tech, Business",
          class: "w-full px-3 py-2 border border-gray-300  bg-white  text-gray-900  rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500  transition" %>
    </div>

    <div>
      <%= f.label :description, "Description (Optional)", class: "block text-sm font-medium text-gray-700  mb-1" %>
      <%= f.text_area :description,
          placeholder: "Brief description shown to users during onboarding",
          rows: 3,
          class: "w-full px-3 py-2 border border-gray-300  bg-white  text-gray-900  rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500  transition" %>
    </div>

    <div>
      <%= f.label :display_order, "Display Order (Optional)", class: "block text-sm font-medium text-gray-700  mb-1" %>
      <%= f.number_field :display_order,
          placeholder: "Lower numbers appear first",
          class: "w-full px-3 py-2 border border-gray-300  bg-white  text-gray-900  rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500  transition" %>
    </div>
  </div>

  <div class="mt-6 flex gap-3">
    <%= f.submit @suggested_feed.new_record? ? "Add Suggested Feed" : "Update Suggested Feed",
        class: "px-4 py-2 bg-blue-600 hover:bg-blue-700  text-white rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 " %>
    <%= link_to "Cancel", admin_suggested_feeds_path, class: "px-4 py-2 bg-gray-200  text-gray-900  rounded-md hover:bg-gray-300 " %>
  </div>
<% end %>
