<% content_for :title, "User Administration" %>

<div class="min-h-screen bg-gray-50 dark:bg-gray-900 py-8">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-semibold text-gray-900 dark:text-gray-100">User Administration</h1>
      <p class="text-sm text-gray-500 dark:text-gray-400">
        Manage account confirmation and admin access.
      </p>
    </div>

    <div class="bg-white dark:bg-gray-950 shadow-lg rounded-lg overflow-hidden border border-gray-200 dark:border-gray-700">
    <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
      <thead class="bg-gray-50 dark:bg-gray-900">
        <tr>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Email</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Status</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Created</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Confirmed</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Admin</th>
          <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white dark:bg-gray-950 divide-y divide-gray-200 dark:divide-gray-700">
        <% @users.each do |user| %>
          <tr>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 dark:text-gray-100">
              <%= user.email_address %>
              <% if user == Current.user %>
                <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">You</span>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">
              <% if user.confirmed? %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">Confirmed</span>
              <% else %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200">Pending</span>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">
              <%= l(user.created_at, format: :short) %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">
              <% if user.confirmed_at.present? %>
                <div>
                  <div><%= l(user.confirmed_at, format: :short) %></div>
                  <% if user.confirmed_by.present? %>
                    <div class="text-xs text-gray-400">by <%= user.confirmed_by.email_address %></div>
                  <% end %>
                </div>
              <% else %>
                <span class="text-xs text-gray-400">Waiting for approval</span>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">
              <% if user.admin? %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200">Admin</span>
              <% else %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-200">User</span>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-right space-x-2">
              <% unless user.confirmed? %>
                <%= button_to "Confirm", confirm_admin_user_path(user), method: :patch, class: "inline-flex items-center px-3 py-1.5 bg-green-600 hover:bg-green-700 dark:hover:bg-green-500 text-white text-xs font-medium rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900", data: { turbo_confirm: "Confirm #{user.email_address}?" } %>
              <% end %>

              <% if user != Current.user %>
                <% if user.admin? %>
                  <%= button_to "Revoke Admin", admin_user_path(user, user: { admin: false }), method: :patch, class: "inline-flex items-center px-3 py-1.5 bg-red-600 hover:bg-red-700 dark:hover:bg-red-500 text-white text-xs font-medium rounded-md focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900", data: { turbo_confirm: "Remove admin rights from #{user.email_address}?" } %>
                <% else %>
                  <%= button_to "Make Admin", admin_user_path(user, user: { admin: true }), method: :patch, class: "inline-flex items-center px-3 py-1.5 bg-blue-600 hover:bg-blue-700 dark:hover:bg-blue-500 text-white text-xs font-medium rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900", data: { turbo_confirm: "Grant admin rights to #{user.email_address}?" } %>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  </div>
</div>
