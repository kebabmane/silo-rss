<div class="border border-green-200 dark:border-green-800 bg-green-50 dark:bg-green-900/20 rounded-md p-4">
  <h3 class="text-lg font-semibold text-green-900 dark:text-green-100 mb-2">Feed Found!</h3>
  <p class="text-sm text-green-700 dark:text-green-300 mb-4">
    <strong><%= feed.title %></strong>
  </p>

  <%= form_with url: feeds_path, method: :post do |f| %>
    <%= f.hidden_field :feed_id, value: feed.id %>

    <div class="mb-4">
      <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
        Category
      </label>
      <%= f.text_field :category,
          placeholder: "e.g., Tech, News, Blogs",
          required: true,
          list: "existing_categories",
          class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white" %>
      <datalist id="existing_categories">
        <% existing_categories.each do |category| %>
          <option value="<%= category %>">
        <% end %>
      </datalist>
    </div>

    <div class="mb-4">
      <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
        Custom Name (optional)
      </label>
      <%= f.text_field :custom_name,
          placeholder: "Leave blank to use feed title",
          class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-white" %>
    </div>

    <%= f.submit "Add to My Feeds",
        class: "w-full px-4 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500" %>
  <% end %>
</div>
