<% if article %>
  <% state = article.state_for(Current.user) %>
  <article class="max-w-2xl mx-auto px-6 py-10 md:px-8 md:py-12 space-y-8">
    <header class="space-y-4 mb-8">
      <div class="space-y-3">
        <h1 class="text-3xl md:text-4xl font-bold text-gray-900  leading-snug">
          <%= article.title %>
        </h1>
      </div>
      <div class="flex flex-wrap items-center justify-between gap-4 text-base text-gray-600 ">
        <div class="flex flex-wrap items-center gap-3">
          <span class="font-semibold text-gray-700 "><%= article.feed.title %></span>
          <% if article.published_at.present? %>
            <span aria-hidden="true">•</span>
            <time datetime="<%= article.published_at.iso8601 %>" class="text-gray-500 "><%= format_user_time(article.published_at, style: :long_date) %></time>
          <% end %>
        </div>
        <% if article.url.present? %>
          <div class="flex items-center gap-2">
            <a href="<%= article.url %>" target="_blank" class="inline-flex items-center gap-2 px-3 py-1.5 text-sm rounded-full text-blue-600  border border-transparent hover:bg-blue-50  transition whitespace-nowrap">
              View Original →
            </a>
          </div>
        <% end %>
      </div>
    </header>

    <% base_toolbar_classes = "inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg border transition focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" %>

    <!-- Article Actions -->
    <div class="flex flex-wrap items-center gap-3">
      <%= button_to toggle_read_article_path(article),
          method: :patch,
          class: "#{base_toolbar_classes} #{state.read? ? 'bg-gray-100  border-gray-300  text-gray-700  hover:bg-gray-200 ' : 'bg-blue-50  border-blue-300  text-blue-700  hover:bg-blue-100 '}",
          data: { turbo: false } do %>
        <%= state.read? ? "Mark Unread" : "Mark Read" %>
      <% end %>

      <%= button_to toggle_starred_article_path(article),
          method: :patch,
          class: "#{base_toolbar_classes} #{state.starred? ? 'bg-amber-50  border-amber-300  text-amber-700  hover:bg-amber-100 ' : 'bg-gray-100  border-gray-300  text-gray-700  hover:bg-gray-200 '}",
          data: { turbo: false } do %>
        <%= state.starred? ? "⭐ Starred" : "☆ Star" %>
      <% end %>

      <%= button_to toggle_archived_article_path(article),
          method: :patch,
          class: "#{base_toolbar_classes} bg-gray-100  border-gray-300  text-gray-700  hover:bg-gray-200 " do %>
        Archive
      <% end %>

      <%= button_to fetch_content_article_path(article),
          method: :post,
          class: "#{base_toolbar_classes} #{article.full_content_fetched? ? 'bg-green-50  border-green-300  text-green-700  hover:bg-green-100 ' : 'bg-purple-50  border-purple-300  text-purple-700  hover:bg-purple-100 '}" do %>
        <%= article.full_content_fetched? ? "🔄 Re-fetch Content" : "📥 Fetch Full Content" %>
      <% end %>
    </div>

    <!-- Article Content -->
    <div class="prose prose-base  max-w-none article-content leading-relaxed [&_p]:leading-relaxed [&_p]:text-gray-700 [&_p]: [&_p]:text-base [&_li]:text-gray-700 [&_li]:">
      <%= sanitize article.display_content, tags: %w[div p br strong em a h1 h2 h3 h4 h5 h6 ul ol li blockquote img pre code span table thead tbody tr th td], attributes: %w[href src alt class] %>
    </div>
  </article>

  <!-- Auto-mark as read -->
  <% unless state.read? %>
    <%= turbo_stream_from "article_#{article.id}" %>
    <script nonce="<%= request.content_security_policy_nonce %>">
      setTimeout(() => {
        fetch('<%= toggle_read_article_path(article) %>', {
          method: 'PATCH',
          headers: {
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
          }
        });
      }, 2000);
    </script>
  <% end %>
<% else %>
  <div class="flex items-center justify-center h-full">
    <div class="text-center max-w-sm px-6">
      <div class="w-16 h-16 mx-auto mb-4 flex items-center justify-center bg-gray-100  rounded-full">
        <svg class="w-8 h-8 text-gray-400 " fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-gray-900  mb-2">
        Select an article to read
      </h3>
      <p class="text-sm text-gray-600 ">
        Click on an article from the search results to view its content
      </p>
    </div>
  </div>
<% end %>
