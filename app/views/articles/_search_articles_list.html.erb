<!-- Search Bar -->
<div class="p-4 border-b border-gray-200 dark:border-gray-700 flex-shrink-0">
  <%= form_with url: search_path, method: :get, data: { turbo_frame: "articles_list" }, class: "relative" do |f| %>
    <%= f.text_field :q,
        placeholder: "Search articles...",
        value: query,
        class: "w-full px-4 py-2 pr-20 text-sm border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent",
        autofocus: true %>
    <div class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center gap-1">
      <% if query.present? %>
        <%= link_to dashboard_path,
            data: { turbo_frame: "articles_list" },
            class: "px-2 py-1 text-xs text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200" do %>
          Clear
        <% end %>
      <% end %>
      <%= f.submit "Search", class: "px-3 py-1 text-xs bg-blue-600 hover:bg-blue-700 text-white rounded-md cursor-pointer" %>
    </div>
  <% end %>
</div>

<div class="divide-y divide-gray-200 dark:divide-gray-700 flex-1 overflow-y-auto">
  <% if query.present? %>
    <% if articles.any? %>
      <% selected_id = selected_article_id.to_i if selected_article_id.present? %>
      <% articles.each do |article| %>
        <% state = article.state_for(Current.user) %>
        <%= link_to search_path(q: query, article_id: article.id),
            class: "block p-4 hover:bg-gray-50 dark:hover:bg-gray-700 #{state.read? ? 'opacity-60' : 'font-semibold'} #{selected_id == article.id ? 'bg-blue-50 dark:bg-blue-900' : ''}",
            data: {
              turbo_frame: "article_content",
              action: "click->keyboard#selectArticle",
              article_id: article.id
            } do %>
          <div class="flex items-start justify-between">
            <div class="flex-1 min-w-0">
              <p class="text-sm text-gray-900 dark:text-white truncate">
                <%= article.title %>
              </p>
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                <%= article.feed.title %>
              </p>
              <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">
                <%= format_user_time(article.published_at, style: :short_date) %>
              </p>
            </div>
            <% if state.starred? %>
              <span class="ml-2 text-yellow-400">⭐</span>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% else %>
      <div class="p-8 text-center text-gray-500 dark:text-gray-400">
        <p>No articles found matching "<%= query %>"</p>
        <p class="text-sm mt-2">Try a different search term</p>
      </div>
    <% end %>
  <% else %>
    <div class="p-8 text-center text-gray-500 dark:text-gray-400">
      <p>Enter a search term to find articles</p>
    </div>
  <% end %>
</div>
