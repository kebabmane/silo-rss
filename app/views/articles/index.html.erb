<div class="max-w-4xl mx-auto p-4">
  <h1 class="font-bold text-2xl mb-4 text-gray-900 ">Articles</h1>

  <% if @articles.any? %>
    <ul class="space-y-4">
      <% @articles.each do |article| %>
        <li class="bg-white  rounded-lg shadow p-4">
          <%= link_to article.title, article_path(article), class: "text-lg font-medium text-blue-600  hover:underline" %>
          <p class="text-sm text-gray-500  mt-1">
            <%= article.feed.title %> &middot; <%= time_ago_in_words(article.published_at) %> ago
          </p>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-gray-500 ">No articles found.</p>
  <% end %>
</div>
