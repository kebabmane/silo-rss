<div class="max-w-4xl mx-auto p-4">
  <article class="bg-white  rounded-lg shadow p-6">
    <header class="mb-4">
      <h1 class="font-bold text-2xl text-gray-900 "><%= @article.title %></h1>
      <p class="text-sm text-gray-500  mt-2">
        <%= @article.feed.title %> &middot; <%= time_ago_in_words(@article.published_at) %> ago
      </p>
      <% if @article.url.present? %>
        <%= link_to "View Original", @article.url, target: "_blank", rel: "noopener", class: "text-blue-600  hover:underline text-sm" %>
      <% end %>
    </header>

    <div class="prose  max-w-none">
      <%= sanitize(@article.content) %>
    </div>

    <footer class="mt-6 pt-4 border-t border-gray-200  flex gap-4">
      <%= button_to @article_state.read ? "Mark Unread" : "Mark Read", toggle_read_article_path(@article), method: :patch, class: "text-sm text-gray-600  hover:text-gray-900 " %>
      <%= button_to @article_state.starred ? "Unstar" : "Star", toggle_starred_article_path(@article), method: :patch, class: "text-sm text-gray-600  hover:text-gray-900 " %>
      <%= button_to @article_state.archived ? "Unarchive" : "Archive", toggle_archived_article_path(@article), method: :patch, class: "text-sm text-gray-600  hover:text-gray-900 " %>
    </footer>
  </article>
</div>
