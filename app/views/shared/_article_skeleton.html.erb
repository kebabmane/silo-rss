<!-- Article Card Skeleton - Repeated multiple times for skeleton loading effect -->
<div class="px-4 py-4 border-l-4 border-transparent animate-pulse">
  <div class="flex items-start gap-3">
    <div class="mt-1.5 h-3 w-3 rounded-full bg-gray-300 dark:bg-gray-700 flex-shrink-0"></div>
    <div class="flex-1 min-w-0">
      <!-- Title skeleton -->
      <div class="h-5 bg-gray-300 dark:bg-gray-700 rounded w-3/4 mb-3"></div>

      <!-- Preview skeleton -->
      <div class="space-y-2 mb-3">
        <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-full"></div>
        <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-5/6"></div>
      </div>

      <!-- Metadata skeleton -->
      <div class="flex items-center gap-2">
        <div class="h-3 bg-gray-200 dark:bg-gray-700 rounded w-24"></div>
        <div class="h-3 bg-gray-200 dark:bg-gray-700 rounded w-20"></div>
      </div>
    </div>
  </div>
</div>
