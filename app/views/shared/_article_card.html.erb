<%# Compact article row - FreshRSS inspired design %>
<%= link_to dashboard_path(article_id: article.id),
    class: "group flex items-center gap-3 px-4 py-3 border-b border-gray-200  hover:bg-gray-50  transition-colors #{selected ? 'bg-blue-50 ' : ''}",
    data: {
      turbo_frame: "article_content",
      article_id: article.id
    } do %>
  
  <%# Read/Unread Icon %>
  <span class="flex-shrink-0" aria-label="<%= read ? 'Read' : 'Unread' %>">
    <% if read %>
      <%# Open envelope (read) %>
      <svg class="w-5 h-5 text-gray-400 " fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
      </svg>
    <% else %>
      <%# Closed envelope (unread) with blue accent %>
      <svg class="w-5 h-5 text-blue-500 " fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
      </svg>
    <% end %>
  </span>

  <%# Star Icon %>
  <span class="flex-shrink-0" aria-label="<%= starred ? 'Starred' : 'Not starred' %>">
    <% if starred %>
      <%# Filled star %>
      <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd" />
      </svg>
    <% else %>
      <%# Empty star outline (subtle) %>
      <svg class="w-4 h-4 text-gray-300  opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
      </svg>
    <% end %>
  </span>

  <%# Feed Name %>
  <span class="flex-shrink-0 text-xs text-gray-500  truncate max-w-[100px]">
    <%= article.feed.title %>
  </span>

  <%# Title %>
  <span class="flex-1 min-w-0 text-sm <%= read ? 'font-normal text-gray-600 ' : 'font-semibold text-gray-900 ' %> truncate">
    <%= article.title %>
  </span>

  <%# Reading Time %>
  <span class="flex-shrink-0 text-xs text-gray-400 ">
    <%= article.reading_time %>
  </span>

  <%# Relative Time %>
  <% if article.published_at.present? %>
    <time class="flex-shrink-0 text-xs text-gray-400 " datetime="<%= article.published_at.iso8601 %>">
      <%= relative_time(article.published_at) %>
    </time>
  <% end %>
<% end %>
