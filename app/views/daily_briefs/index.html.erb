<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Daily Briefs</h1>
    <%= link_to "Manage Schedules", daily_brief_schedules_path, class: "px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700" %>
  </div>

  <% if @briefs.empty? %>
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6 text-center">
      <p class="text-gray-600 dark:text-gray-400 mb-4">No daily briefs generated yet.</p>
      <%= link_to "Create a schedule", daily_brief_schedules_path, class: "text-blue-600 hover:text-blue-800 dark:text-blue-400" %>
    </div>
  <% else %>
    <div class="space-y-4">
      <% @briefs.each do |brief| %>
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow hover:shadow-lg transition-shadow">
          <%= link_to daily_brief_path(brief), class: "block p-6" do %>
            <div class="flex justify-between items-start">
              <div class="flex-1">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
                  <%= brief.generated_at.strftime("%B %d, %Y at %I:%M %p") %>
                  <% unless brief.read? %>
                    <span class="ml-2 px-2 py-1 text-xs bg-blue-100 text-blue-800 dark:bg-blue-800 dark:text-blue-100 rounded">Unread</span>
                  <% end %>
                </h3>

                <div class="space-y-1 text-sm text-gray-600 dark:text-gray-400">
                  <p><%= brief.article_count %> <%= "article".pluralize(brief.article_count) %> summarized</p>
                  <% if brief.emailed? %>
                    <p>Emailed on <%= brief.emailed_at.strftime("%B %d at %I:%M %p") %></p>
                  <% end %>
                </div>

                <div class="mt-3 prose dark:prose-invert max-w-none line-clamp-3">
                  <%= markdown(truncate(brief.content, length: 200)) %>
                </div>
              </div>

              <div class="ml-4">
                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if @briefs.respond_to?(:total_pages) && @briefs.total_pages > 1 %>
      <div class="mt-6 flex justify-center">
        <%= paginate @briefs %>
      </div>
    <% end %>
  <% end %>
</div>
