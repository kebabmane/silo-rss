<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Daily Briefs</h1>
    <%= link_to "Manage Schedules", daily_brief_schedules_path, class: "px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700" %>
  </div>

  <% if @briefs.empty? %>
    <div class="bg-white dark:bg-gray-950 rounded-lg shadow p-12 text-center">
      <div class="w-16 h-16 mx-auto mb-4 flex items-center justify-center bg-gray-100 dark:bg-gray-800 rounded-full">
        <svg class="w-8 h-8 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .984.578 1.83 1.43 2.332.512.32 1.08.3 1.494-.04l.766-.468a1.93 1.93 0 011.725 0l.766.468c.414.34.982.36 1.494.04.852-.502 1.43-1.348 1.43-2.332 0-.231-.035-.454-.1-.664m-5.801 0A2.487 2.487 0 019 3.75c0-.577.22-1.136.63-1.55m5.74 0c.41.414.63.973.63 1.55m0 0A2.487 2.487 0 0115 3.75M9 6.75h6M12 12.75h.008v.008H12v-.008z" />
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">No daily briefs yet</h3>
      <p class="text-sm text-gray-600 dark:text-gray-400 mb-6">
        Create a schedule to automatically generate daily summaries of your articles.
      </p>
      <%= link_to "Create a Schedule", daily_brief_schedules_path, class: "inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium transition" %>
    </div>
  <% else %>
    <div class="space-y-4">
      <% @briefs.each do |brief| %>
        <div class="bg-white dark:bg-gray-900 rounded-lg shadow hover:shadow-lg transition-shadow">
          <%= link_to daily_brief_path(brief), class: "block p-6" do %>
            <div class="flex justify-between items-start">
              <div class="flex-1">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
                  <%= format_user_time(brief.generated_at, style: :long) %>
                  <% unless brief.read? %>
                    <span class="ml-2 px-2 py-1 text-xs bg-blue-100 text-blue-800 dark:bg-blue-800 dark:text-blue-100 rounded">Unread</span>
                  <% end %>
                </h3>

                <div class="space-y-1 text-sm text-gray-600 dark:text-gray-400">
                  <p><%= brief.article_count %> <%= "article".pluralize(brief.article_count) %> summarized</p>
                  <% if brief.emailed? %>
                    <p>Emailed on <%= format_user_time(brief.emailed_at, style: :month_day_time) %></p>
                  <% end %>
                </div>

                <div class="mt-3 prose max-w-none article-content line-clamp-3">
                  <%= markdown(truncate(brief.content, length: 200)) %>
                </div>
              </div>

              <div class="ml-4">
                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if @pagy.pages > 1 %>
      <div class="mt-6 flex justify-center">
        <%== @pagy.series_nav(aria_label: 'pagination') %>
      </div>
    <% end %>
  <% end %>
</div>
