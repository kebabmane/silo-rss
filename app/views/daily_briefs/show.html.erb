<div class="container mx-auto px-4 py-8 <%= @brief.digest? ? 'max-w-6xl' : 'max-w-4xl' %>">
  <div class="mb-6 flex justify-between items-center">
    <%= link_to daily_briefs_path, class: "text-blue-600 hover:text-blue-800 dark:text-blue-400 flex items-center" do %>
      <svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      Back to Briefs
    <% end %>

    <div class="flex space-x-2">
      <% if @brief.read? %>
        <%= button_to "Mark Unread", mark_unread_daily_brief_path(@brief), method: :patch, class: "px-3 py-1 text-sm bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded hover:bg-gray-300 dark:hover:bg-gray-600" %>
      <% else %>
        <%= button_to "Mark Read", mark_read_daily_brief_path(@brief), method: :patch, class: "px-3 py-1 text-sm bg-blue-600 text-white rounded hover:bg-blue-700" %>
      <% end %>
    </div>
  </div>

  <% if @brief.digest? && @brief.sections.any? %>
    <!-- Digest Layout with TOC Sidebar -->
    <div class="lg:flex lg:gap-8">
      <!-- Sticky TOC Sidebar (Desktop) -->
      <aside class="hidden lg:block lg:w-64 flex-shrink-0">
        <nav class="sticky top-4 bg-white dark:bg-gray-800 rounded-lg shadow p-4">
          <h3 class="font-semibold text-gray-900 dark:text-white mb-3">Contents</h3>
          <p class="text-xs text-gray-500 dark:text-gray-400 mb-3"><%= @brief.reading_time %> min read</p>
          <ul class="space-y-2 text-sm">
            <% @brief.sections.each do |section| %>
              <li>
                <a href="#<%= section['anchor'] %>" class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition">
                  <%= section['title'] %>
                </a>
              </li>
            <% end %>
          </ul>
        </nav>
      </aside>

      <!-- Main Content -->
      <div class="flex-1 bg-white dark:bg-gray-800 rounded-lg shadow p-8">
        <div class="border-b border-gray-200 dark:border-gray-700 pb-4 mb-6">
          <div class="flex items-center gap-2 mb-2">
            <span class="px-2 py-1 text-xs bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200 rounded">Daily Tech Digest</span>
            <span class="text-sm text-gray-500 dark:text-gray-400"><%= @brief.reading_time %> min read</span>
          </div>
          <h1 class="text-3xl font-bold text-gray-900 dark:text-white">
            <%= format_user_time(@brief.generated_at, style: :long) %>
          </h1>
          <p class="text-sm text-gray-500 dark:text-gray-500 mt-2">
            <%= @brief.article_count %> <%= "article".pluralize(@brief.article_count) %> analyzed
            <% if @brief.themes.any? %>
              <span class="mx-1">&middot;</span>
              <%= @brief.themes.count %> themes covered
            <% end %>
          </p>
        </div>

        <article class="prose prose-lg max-w-none daily-brief-content article-content">
          <%= markdown(@brief.content) %>
        </article>
      </div>
    </div>
  <% else %>
    <!-- Standard Brief Layout -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-8">
      <div class="border-b border-gray-200 dark:border-gray-700 pb-4 mb-6">
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white">
          Daily Brief
        </h1>
        <p class="text-gray-600 dark:text-gray-400 mt-2">
          <%= format_user_time(@brief.generated_at, style: :long) %>
        </p>
        <p class="text-sm text-gray-500 dark:text-gray-500 mt-1">
          <%= @brief.article_count %> <%= "article".pluralize(@brief.article_count) %> summarized
          <span class="mx-1">&middot;</span>
          <%= @brief.reading_time %> min read
        </p>
      </div>

      <div class="prose prose-lg max-w-none daily-brief-content article-content">
        <%= markdown(@brief.content) %>
      </div>
    </div>
  <% end %>
</div>
