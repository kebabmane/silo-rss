<div class="container mx-auto px-4 py-8 max-w-4xl">
  <div class="mb-6 flex justify-between items-center">
    <%= link_to daily_briefs_path, class: "text-blue-600 hover:text-blue-800 dark:text-blue-400 flex items-center" do %>
      <svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      Back to Briefs
    <% end %>

    <div class="flex space-x-2">
      <% if @brief.read? %>
        <%= button_to "Mark Unread", mark_unread_daily_brief_path(@brief), method: :patch, class: "px-3 py-1 text-sm bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded hover:bg-gray-300 dark:hover:bg-gray-600" %>
      <% else %>
        <%= button_to "Mark Read", mark_read_daily_brief_path(@brief), method: :patch, class: "px-3 py-1 text-sm bg-blue-600 text-white rounded hover:bg-blue-700" %>
      <% end %>
    </div>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-8">
    <div class="border-b border-gray-200 dark:border-gray-700 pb-4 mb-6">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white">
        Daily Brief
      </h1>
      <p class="text-gray-600 dark:text-gray-400 mt-2">
        <%= @brief.generated_at.strftime("%B %d, %Y at %I:%M %p") %>
      </p>
      <p class="text-sm text-gray-500 dark:text-gray-500 mt-1">
        <%= @brief.article_count %> <%= "article".pluralize(@brief.article_count) %> summarized
      </p>
    </div>

    <div class="prose prose-lg dark:prose-invert max-w-none daily-brief-content">
      <%= markdown(@brief.content) %>
    </div>
  </div>
</div>
