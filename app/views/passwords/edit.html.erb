<div class="mx-auto max-w-md w-full bg-white dark:bg-gray-800 p-8 rounded-lg shadow-lg">
  <% if alert = flash[:alert] %>
    <p class="py-2 px-3 bg-red-50 dark:bg-red-900 mb-5 text-red-500 dark:text-red-200 font-medium rounded-lg inline-block" id="alert"><%= alert %></p>
  <% end %>

  <% if notice = flash[:notice] %>
    <p class="py-2 px-3 bg-green-50 dark:bg-green-900 mb-5 text-green-500 dark:text-green-200 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>

  <h1 class="font-bold text-3xl text-gray-900 dark:text-white mb-2">Update your password</h1>
  <p class="text-sm text-gray-600 dark:text-gray-300 mb-6">
    Choose a strong password you haven’t used before to keep your account secure.
  </p>

  <%= form_with url: password_path(params[:token]), method: :put do |form| %>
    <div class="mb-5">
      <%= form.label :password, "New password", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" %>
      <%= form.password_field :password,
          required: true,
          autocomplete: "new-password",
          placeholder: "Enter new password",
          minlength: 8,
          maxlength: 72,
          class: "block w-full rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white px-3 py-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 min-h-[44px]" %>
      <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Minimum 8 characters</p>
    </div>

    <div class="mb-5">
      <%= form.label :password_confirmation, "Confirm password", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" %>
      <%= form.password_field :password_confirmation,
          required: true,
          autocomplete: "new-password",
          placeholder: "Repeat new password",
          maxlength: 72,
          class: "block w-full rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white px-3 py-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 min-h-[44px]" %>
    </div>

    <div class="mb-5">
      <%= form.submit "Save password", class: "w-full rounded-md px-4 py-2.5 bg-blue-600 hover:bg-blue-700 dark:hover:bg-blue-500 text-white font-medium cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-950 transition-all min-h-[44px]", aria_label: "Save your new password" %>
    </div>
  <% end %>
</div>
