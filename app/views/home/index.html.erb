<% content_for :title, "Silo – Your Personal Internet Feed" %>

<div class="min-h-screen bg-gradient-to-b from-gray-50 via-white to-blue-50 dark:from-gray-900 dark:via-gray-900 dark:to-gray-950">
  <div class="relative isolate overflow-hidden">
    <div class="mx-auto max-w-7xl px-6 pt-24 pb-16 sm:pt-32 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <span class="inline-flex items-center rounded-full bg-blue-100 px-4 py-1 text-sm font-medium text-blue-700 dark:bg-blue-900 dark:text-blue-200">
          Curate a feed that's just for you
        </span>
        <h1 class="mt-6 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl dark:text-white">
          Welcome to Silo
        </h1>
        <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300">
          Silo lets you collect the parts of the internet you care about into a calm, focused reading experience.
          Subscribe to your favorite sites, skim daily briefs, and stay in flow with thoughtful tools that help you read with intention.
        </p>
        <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <%= link_to "Start Your Silo", new_registration_path, class: "inline-flex items-center justify-center rounded-lg bg-blue-600 px-6 py-3 text-base font-semibold text-white shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-all", aria_label: "Create a new account" %>
          <%= link_to "Sign In", new_session_path, class: "inline-flex items-center justify-center rounded-lg border border-transparent px-6 py-3 text-base font-semibold text-blue-700 hover:text-blue-900 hover:bg-blue-100 dark:text-blue-300 dark:hover:text-blue-200 dark:hover:bg-blue-900/40 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-all" %>
        </div>
      </div>

      <div class="mt-20 grid gap-12 lg:grid-cols-3">
        <div class="group rounded-2xl bg-white p-8 shadow-lg ring-1 ring-gray-100 dark:bg-gray-900 dark:ring-gray-800 transition-all duration-300 ease-in-out hover:shadow-xl hover:-translate-y-1 hover:ring-2 hover:ring-blue-500 dark:hover:ring-blue-400">
          <div class="flex items-center gap-3">
            <span class="flex h-12 w-12 items-center justify-center rounded-full bg-blue-100 text-blue-600 dark:bg-blue-900/60 dark:text-blue-200 text-2xl transition-transform duration-300 group-hover:scale-110">📥</span>
            <h2 class="text-xl font-semibold text-gray-900 dark:text-white">Collect with purpose</h2>
          </div>
          <p class="mt-4 text-sm leading-6 text-gray-600 dark:text-gray-300">
            Import OPML files, add feeds on the fly, and keep everything organized by category so your reading time stays intentional.
          </p>
        </div>

        <div class="group rounded-2xl bg-white p-8 shadow-lg ring-1 ring-gray-100 dark:bg-gray-900 dark:ring-gray-800 transition-all duration-300 ease-in-out hover:shadow-xl hover:-translate-y-1 hover:ring-2 hover:ring-blue-500 dark:hover:ring-blue-400">
          <div class="flex items-center gap-3">
            <span class="flex h-12 w-12 items-center justify-center rounded-full bg-blue-100 text-blue-600 dark:bg-blue-900/60 dark:text-blue-200 text-2xl transition-transform duration-300 group-hover:scale-110">📬</span>
            <h2 class="text-xl font-semibold text-gray-900 dark:text-white">Stay in the loop</h2>
          </div>
          <p class="mt-4 text-sm leading-6 text-gray-600 dark:text-gray-300">
            Daily briefs highlight what's new across your silo. Skim summaries in your inbox or dive deeper when you're ready.
          </p>
        </div>

        <div class="group rounded-2xl bg-white p-8 shadow-lg ring-1 ring-gray-100 dark:bg-gray-900 dark:ring-gray-800 transition-all duration-300 ease-in-out hover:shadow-xl hover:-translate-y-1 hover:ring-2 hover:ring-blue-500 dark:hover:ring-blue-400">
          <div class="flex items-center gap-3">
            <span class="flex h-12 w-12 items-center justify-center rounded-full bg-blue-100 text-blue-600 dark:bg-blue-900/60 dark:text-blue-200 text-2xl transition-transform duration-300 group-hover:scale-110">✨</span>
            <h2 class="text-xl font-semibold text-gray-900 dark:text-white">A calm reading space</h2>
          </div>
          <p class="mt-4 text-sm leading-6 text-gray-600 dark:text-gray-300">
            Keyboard shortcuts, dark mode, and focused layouts keep articles front and center so you can enjoy reading again.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Dashboard Preview Section -->
  <div class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
    <div class="text-center mb-12">
      <h3 class="text-3xl font-bold text-gray-900 dark:text-white">Experience a focused reading environment</h3>
      <p class="mt-4 text-lg text-gray-600 dark:text-gray-300">See how Silo helps you stay organized and engaged with your content</p>
    </div>

    <div class="grid gap-8 lg:grid-cols-3">
      <div class="rounded-2xl bg-white dark:bg-gray-900 p-6 shadow-lg ring-1 ring-gray-100 dark:ring-gray-800">
        <div class="aspect-video bg-gradient-to-br from-blue-50 to-blue-100 dark:from-blue-950 dark:to-blue-900 rounded-lg mb-4 flex items-center justify-center">
          <div class="text-center">
            <div class="text-4xl mb-2">📚</div>
            <p class="text-sm text-gray-700 dark:text-gray-300 font-medium">Organized Feeds</p>
          </div>
        </div>
        <h4 class="font-semibold text-gray-900 dark:text-white mb-2">Category-based organization</h4>
        <p class="text-sm text-gray-600 dark:text-gray-400">Group your feeds by topic with a clean sidebar navigation. Switch between categories instantly.</p>
      </div>

      <div class="rounded-2xl bg-white dark:bg-gray-900 p-6 shadow-lg ring-1 ring-gray-100 dark:ring-gray-800">
        <div class="aspect-video bg-gradient-to-br from-purple-50 to-purple-100 dark:from-purple-950 dark:to-purple-900 rounded-lg mb-4 flex items-center justify-center">
          <div class="text-center">
            <div class="text-4xl mb-2">📖</div>
            <p class="text-sm text-gray-700 dark:text-gray-300 font-medium">Distraction-Free Reading</p>
          </div>
        </div>
        <h4 class="font-semibold text-gray-900 dark:text-white mb-2">Three-column layout</h4>
        <p class="text-sm text-gray-600 dark:text-gray-400">Browse feeds, scan articles, and read in a focused view. Everything in one screen.</p>
      </div>

      <div class="rounded-2xl bg-white dark:bg-gray-900 p-6 shadow-lg ring-1 ring-gray-100 dark:ring-gray-800">
        <div class="aspect-video bg-gradient-to-br from-green-50 to-green-100 dark:from-green-950 dark:to-green-900 rounded-lg mb-4 flex items-center justify-center">
          <div class="text-center">
            <div class="text-4xl mb-2">⚡</div>
            <p class="text-sm text-gray-700 dark:text-gray-300 font-medium">Keyboard Shortcuts</p>
          </div>
        </div>
        <h4 class="font-semibold text-gray-900 dark:text-white mb-2">Navigate at speed</h4>
        <p class="text-sm text-gray-600 dark:text-gray-400">Use keyboard shortcuts to move between articles, mark as read, star favorites, and more.</p>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-6 pb-24 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <div class="rounded-3xl bg-white p-8 shadow-lg ring-1 ring-gray-100 dark:bg-gray-900 dark:ring-gray-800">
        <h3 class="text-2xl font-semibold text-gray-900 dark:text-white">Why build your own silo?</h3>
        <p class="mt-4 text-sm leading-6 text-gray-600 dark:text-gray-300">
          Social timelines and algorithmic feeds aren't designed for depth. Silo is different—it lets you choose what matters, organize it your way, and revisit it on your own schedule.
        </p>
        <ul class="mt-6 space-y-3 text-sm text-gray-600 dark:text-gray-300">
          <li class="flex items-start gap-3"><span class="mt-1 text-blue-500">•</span> Own your reading list with exportable data.</li>
          <li class="flex items-start gap-3"><span class="mt-1 text-blue-500">•</span> Keep work, personal projects, and curiosities siloed but accessible.</li>
          <li class="flex items-start gap-3"><span class="mt-1 text-blue-500">•</span> Pause the noise and return when you're ready—everything waits for you.</li>
        </ul>
      </div>

      <div class="flex flex-col gap-6">
        <div class="rounded-3xl bg-gradient-to-br from-blue-600 to-blue-500 p-8 text-white shadow-lg">
          <h4 class="text-lg font-semibold">Built for independent readers</h4>
          <p class="mt-3 text-sm leading-6 text-blue-100">
            Silo is self-hosted, privacy conscious, and tuned for speed. You're in control from discovery to archive.
          </p>
        </div>
        <div class="rounded-3xl border border-dashed border-blue-300 p-8 text-center dark:border-blue-800">
          <p class="text-sm leading-6 text-gray-600 dark:text-gray-300">
            Ready to make the internet yours again?
          </p>
          <div class="mt-4 flex flex-col items-center gap-2 sm:flex-row sm:justify-center">
            <%= link_to "Create your account", new_registration_path, class: "inline-flex items-center justify-center rounded-lg bg-blue-600 px-5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-all min-h-[44px]", aria_label: "Create a new account" %>
            <%= link_to "Already using Silo? Sign in", new_session_path, class: "text-sm font-medium text-blue-700 hover:text-blue-900 dark:text-blue-300 dark:hover:text-blue-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 rounded min-h-[44px] flex items-center" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
