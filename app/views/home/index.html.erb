<% content_for :title, "Silo – Your Personal Internet Feed" %>

<div class="min-h-screen bg-gradient-to-b from-gray-50 via-white to-blue-50   ">
  <div class="relative isolate overflow-hidden">
    <div class="mx-auto max-w-7xl px-6 pt-24 pb-16 sm:pt-32 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <span class="inline-flex items-center rounded-full bg-blue-100 px-4 py-1 text-sm font-medium text-blue-700  ">
          Curate a feed that's just for you
        </span>
        <h1 class="mt-6 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl ">
          Welcome to Silo
        </h1>
        <p class="mt-6 text-lg leading-8 text-gray-600 ">
          Silo lets you collect the parts of the internet you care about into a calm, focused reading experience.
          Subscribe to your favorite sites and stay in flow with thoughtful tools that help you read with intention.
        </p>
        <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <%= link_to "Start Your Silo", new_registration_path, class: "inline-flex items-center justify-center rounded-lg bg-blue-600 px-6 py-3 text-base font-semibold text-white shadow-sm hover:bg-blue-700  focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2  transition-all", aria_label: "Create a new account" %>
          <%= link_to "Sign In", new_session_path, class: "inline-flex items-center justify-center rounded-lg border border-transparent px-6 py-3 text-base font-semibold text-blue-700 hover:text-blue-900 hover:bg-blue-100    focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2  transition-all" %>
        </div>
      </div>

      <div class="mt-20 grid gap-12 lg:grid-cols-3">
        <div class="group rounded-2xl bg-white p-8 shadow-lg ring-1 ring-gray-100   transition-all duration-300 ease-in-out hover:shadow-xl hover:-translate-y-1 hover:ring-2 hover:ring-blue-500 ">
          <div class="flex items-center gap-3">
            <span class="flex h-12 w-12 items-center justify-center rounded-full bg-blue-100 text-blue-600   text-2xl transition-transform duration-300 group-hover:scale-110">📥</span>
            <h2 class="text-xl font-semibold text-gray-900 ">Collect with purpose</h2>
          </div>
          <p class="mt-4 text-sm leading-6 text-gray-600 ">
            Import OPML files, add feeds on the fly, and keep everything organized by category so your reading time stays intentional.
          </p>
        </div>

        <div class="group rounded-2xl bg-white p-8 shadow-lg ring-1 ring-gray-100   transition-all duration-300 ease-in-out hover:shadow-xl hover:-translate-y-1 hover:ring-2 hover:ring-blue-500 ">
          <div class="flex items-center gap-3">
            <span class="flex h-12 w-12 items-center justify-center rounded-full bg-blue-100 text-blue-600   text-2xl transition-transform duration-300 group-hover:scale-110">📬</span>
            <h2 class="text-xl font-semibold text-gray-900 ">Stay in the loop</h2>
          </div>
          <p class="mt-4 text-sm leading-6 text-gray-600 ">
            Get notified when new articles arrive across your feeds. Skim summaries and dive deeper when you're ready.
          </p>
        </div>

        <div class="group rounded-2xl bg-white p-8 shadow-lg ring-1 ring-gray-100   transition-all duration-300 ease-in-out hover:shadow-xl hover:-translate-y-1 hover:ring-2 hover:ring-blue-500 ">
          <div class="flex items-center gap-3">
            <span class="flex h-12 w-12 items-center justify-center rounded-full bg-blue-100 text-blue-600   text-2xl transition-transform duration-300 group-hover:scale-110">✨</span>
            <h2 class="text-xl font-semibold text-gray-900 ">A calm reading space</h2>
          </div>
          <p class="mt-4 text-sm leading-6 text-gray-600 ">
            A clean, focused reading environment keeps articles front and center so you can enjoy reading again.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Dashboard Preview Section -->
  <div class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
    <div class="text-center mb-12">
      <h3 class="text-3xl font-bold text-gray-900 ">Experience a focused reading environment</h3>
      <p class="mt-4 text-lg text-gray-600 ">See how Silo helps you stay organized and engaged with your content</p>
    </div>

    <div class="grid gap-8 lg:grid-cols-3">
      <div class="rounded-2xl bg-white  p-6 shadow-lg ring-1 ring-gray-100 ">
        <div class="aspect-video bg-gradient-to-br from-blue-50 to-blue-100   rounded-lg mb-4 flex items-center justify-center">
          <div class="text-center">
            <div class="text-4xl mb-2">📚</div>
            <p class="text-sm text-gray-700  font-medium">Organized Feeds</p>
          </div>
        </div>
        <h4 class="font-semibold text-gray-900  mb-2">Category-based organization</h4>
        <p class="text-sm text-gray-600 ">Group your feeds by topic with a clean sidebar navigation. Switch between categories instantly.</p>
      </div>

      <div class="rounded-2xl bg-white  p-6 shadow-lg ring-1 ring-gray-100 ">
        <div class="aspect-video bg-gradient-to-br from-purple-50 to-purple-100   rounded-lg mb-4 flex items-center justify-center">
          <div class="text-center">
            <div class="text-4xl mb-2">📖</div>
            <p class="text-sm text-gray-700  font-medium">Distraction-Free Reading</p>
          </div>
        </div>
        <h4 class="font-semibold text-gray-900  mb-2">Three-column layout</h4>
        <p class="text-sm text-gray-600 ">Browse feeds, scan articles, and read in a focused view. Everything in one screen.</p>
      </div>

      <div class="rounded-2xl bg-white  p-6 shadow-lg ring-1 ring-gray-100 ">
        <div class="aspect-video bg-gradient-to-br from-green-50 to-green-100   rounded-lg mb-4 flex items-center justify-center">
          <div class="text-center">
            <div class="text-4xl mb-2">⚡</div>
            <p class="text-sm text-gray-700  font-medium">Fast Navigation</p>
          </div>
        </div>
        <h4 class="font-semibold text-gray-900  mb-2">Browse efficiently</h4>
        <p class="text-sm text-gray-600 ">Quickly browse articles, mark as read, star favorites, and stay organized with an intuitive interface.</p>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-6 pb-24 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <div class="rounded-3xl bg-white p-8 shadow-lg ring-1 ring-gray-100  ">
        <h3 class="text-2xl font-semibold text-gray-900 ">Why build your own silo?</h3>
        <p class="mt-4 text-sm leading-6 text-gray-600 ">
          Social timelines and algorithmic feeds aren't designed for depth. Silo is different—it lets you choose what matters, organize it your way, and revisit it on your own schedule.
        </p>
        <ul class="mt-6 space-y-3 text-sm text-gray-600 ">
          <li class="flex items-start gap-3"><span class="mt-1 text-blue-500">•</span> Own your reading list with exportable data.</li>
          <li class="flex items-start gap-3"><span class="mt-1 text-blue-500">•</span> Keep work, personal projects, and curiosities siloed but accessible.</li>
          <li class="flex items-start gap-3"><span class="mt-1 text-blue-500">•</span> Pause the noise and return when you're ready—everything waits for you.</li>
        </ul>
      </div>

      <div class="flex flex-col gap-6">
        <div class="rounded-3xl bg-gradient-to-br from-blue-600 to-blue-500 p-8 text-white shadow-lg">
          <h4 class="text-lg font-semibold">Built for independent readers</h4>
          <p class="mt-3 text-sm leading-6 text-blue-100">
            Silo is self-hosted, privacy conscious, and tuned for speed. You're in control from discovery to archive.
          </p>
        </div>
        <div class="rounded-3xl border border-dashed border-blue-300 p-8 text-center ">
          <p class="text-sm leading-6 text-gray-600 ">
            Ready to make the internet yours again?
          </p>
          <div class="mt-4 flex flex-col items-center gap-2 sm:flex-row sm:justify-center">
            <%= link_to "Create your account", new_registration_path, class: "inline-flex items-center justify-center rounded-lg bg-blue-600 px-5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-all min-h-[44px]", aria_label: "Create a new account" %>
            <%= link_to "Already using Silo? Sign in", new_session_path, class: "text-sm font-medium text-blue-700 hover:text-blue-900   focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 rounded min-h-[44px] flex items-center" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
