<div class="mx-auto max-w-md w-full bg-white dark:bg-gray-800 p-8 rounded-lg shadow-lg">
  <% if alert = flash[:alert] %>
    <div class="mb-5 p-4 bg-red-50 dark:bg-red-900/40 border-l-4 border-red-500 dark:border-red-700 rounded" role="alert">
      <div class="flex items-start">
        <svg class="w-5 h-5 text-red-500 dark:text-red-400 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
        </svg>
        <p class="ml-3 text-sm text-red-700 dark:text-red-200 font-medium"><%= alert %></p>
      </div>
    </div>
  <% end %>

  <% if notice = flash[:notice] %>
    <div class="mb-5 p-4 bg-green-50 dark:bg-green-900/40 border-l-4 border-green-500 dark:border-green-700 rounded" role="alert">
      <div class="flex items-start">
        <svg class="w-5 h-5 text-green-500 dark:text-green-400 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <p class="ml-3 text-sm text-green-700 dark:text-green-200 font-medium"><%= notice %></p>
      </div>
    </div>
  <% end %>

  <h1 class="font-bold text-3xl text-gray-900 dark:text-white mb-6">Sign in</h1>

  <%= form_with url: session_url, html: { id: "login-form" } do |form| %>
    <div class="mb-5">
      <%= form.label :email_address, "Email", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" %>
      <%= form.email_field :email_address,
          required: true,
          autofocus: true,
          autocomplete: "username",
          placeholder: "you@example.com",
          value: params[:email_address],
          aria_describedby: "email-error",
          class: "block w-full rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white px-3 py-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 min-h-[44px]" %>
      <p id="email-error" class="mt-1 text-sm text-red-600 dark:text-red-400 hidden">Please enter a valid email address</p>
    </div>

    <div class="mb-5">
      <%= form.label :password, "Password", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" %>
      <%= form.password_field :password,
          required: true,
          autocomplete: "current-password",
          placeholder: "Enter your password",
          maxlength: 72,
          aria_describedby: "password-error",
          class: "block w-full rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white px-3 py-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 min-h-[44px]" %>
      <p id="password-error" class="mt-1 text-sm text-red-600 dark:text-red-400 hidden">Password is required</p>
    </div>

    <div class="mb-5">
      <%= form.submit "Sign in", class: "w-full rounded-md px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-all min-h-[44px]", aria_label: "Sign in to your account" %>
    </div>

    <div class="flex items-center justify-between text-sm flex-wrap gap-2">
      <%= link_to "Forgot password?", new_password_path, class: "text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 underline focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 rounded min-h-[44px] flex items-center" %>
      <%= link_to "Create account", new_registration_path, class: "text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 font-medium focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 rounded min-h-[44px] flex items-center" %>
    </div>
  <% end %>
</div>
