# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# === Dependency Management ===
/.bundle
/vendor/bundle

# === Environment & Secrets ===
/.env*
/docker.env
/.kamal/
/config/master.key
/config/credentials.yml.enc

# === Logs & Temporary Files ===
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# === Database & Storage ===
/storage/*
!/storage/.keep
db/*.sqlite3
db/*.sqlite3-journal

# === Assets & Builds ===
/public/assets
/public/packs
/public/packs-test
/app/assets/builds/*
!/app/assets/builds/.keep
/node_modules/

# === Test Coverage ===
/coverage
/coverage.data

# === IDE & Editor Files ===
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.iml
*.sublime-workspace
*.sublime-project

# === Debugging & REPL History ===
.byebug_history
.pry_history
.irb_history

# === Test & Screenshot Artifacts ===
*.png
*.jpg
*.jpeg
test_app_ui.js
/tmp/screenshots

# === macOS & Windows ===
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# === Yarn & npm ===
yarn-error.log
npm-debug.log
/yarn-error.log

# === Ruby & Rails ===
.ruby-version.local
.rvmrc
.rvm/
.rbenv/
